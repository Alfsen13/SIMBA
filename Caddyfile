# FrankenPHP Caddyfile for Production
# Port 8000, multi-threaded, dengan 3 queue workers

{
    # Admin API disabled for production
    admin off
    # Auto HTTPS disabled (use reverse proxy for SSL)
    auto_https off

    # FrankenPHP global configuration - initialize PHP engine (no worker mode)
    frankenphp {
        num_threads 4
        max_threads 4
    }
}

:8000 {
    root * /app/public

    # FrankenPHP PHP handler - using php_server directive (FrankenPHP 1.4+)
    php_server

    # Enable compression
    encode zstd gzip

    # Static files caching (manifest.json must NOT be immutable - it changes on rebuild)
    @static {
        path /build/assets/*
        path /storage/*
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    # Manifest must always be revalidated
    @manifest {
        path /build/manifest.json
    }
    header @manifest Cache-Control "no-cache, no-store, must-revalidate"

    # Security headers
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Laravel public files
    try_files {path} {path}/ /index.php?{query}

    # Log access
    log {
        output stdout
        format json
    }
}

# Queue workers sebagai service terpisah (dijalankan via docker-compose)
# Bukan di Caddyfile tapi di docker-compose.yml