# FrankenPHP Caddyfile for Production
# Port 8000, multi-threaded, dengan 3 queue workers

{
    # Admin API disabled for production
    admin off
    # Auto HTTPS disabled (use reverse proxy for SSL)
    auto_https off
}

:8000 {
    root * /app/public

    # FrankenPHP PHP handler - using frankenphp directive
    frankenphp {
        worker 2
        max_workers 4
    }

    # Enable compression
    encode zstd gzip

    # Static files caching
    @static {
        path /build/*
        path /storage/*
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    # Security headers
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Laravel public files
    try_files {path} {path}/ /index.php?{query}

    # Log access
    log {
        output stdout
        format json
    }
}

# Queue workers sebagai service terpisah (dijalankan via docker-compose)
# Bukan di Caddyfile tapi di docker-compose.yml