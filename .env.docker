APP_NAME=SIMBA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=simba
DB_USERNAME=simba
DB_PASSWORD=simba_secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=laravel_session
SESSION_CONNECTION=default
SESSION_STORE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis

CACHE_STORE=redis

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@simba.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI Providers
AI_PROVIDER_PRIORITY=local,gemini
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_FALLBACK_MODEL=qwen2.5:1.5b
OLLAMA_FALLBACK_2_MODEL=simba-tutor-slim
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_SHORT_TIMEOUT=8

# PDF Extraction
PDF_EXTRACT_TIMEOUT=600
PYTHON_PATH="python3.14"

# Embedding
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# Bloom Taxonomy
BLOOM_ENABLED=true

# Remedial
REMEDIAL_COOLDOWN_HARI=7
REMEDIAL_AMBANG_PERTEMUAN=75

# Prediction
PREDIKSI_AMBANG_AMAN=20
PREDIKSI_AMBANG_PANTAU=40

# Web Search
WEB_SEARCH_ENABLED=false

# Symbols / RAG
SYMBOLS_ENABLED=true
SYMBOLS_TOP_K=6
SYMBOLS_MIN_SCORE=1.0

# Kuis RAG
KUIS_RAG_ENABLED=true
KUIS_RAG_TOP_K=6
KUIS_RAG_MIN_SCORE=0.35
KUIS_RAG_MAX_CHARS=8000

# RAG
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=3
RAG_MIN_SCORE=0.4

# Prediksi
PREDIKSI_AMBANG_AMAN=20
PREDIKSI_AMBANG_PANTAU=40

# Bloom
BLOOM_ENABLED=true
BLOOM_MIN_CONFIDENCE=0.34