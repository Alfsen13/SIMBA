# SIMBA Docker Environment Configuration
# Copy to .env and adjust values

APP_NAME="SIMBA"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_KEY=base64:YOUR_APP_KEY_HERE_GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE

# Database (MySQL)
DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=simba
DB_USERNAME=simba
DB_PASSWORD=simba_secret
DB_ROOT_PASSWORD=root_secret

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CLIENT=phpredis

# Queue & Cache
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis

# Mail (configure for production)
MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@simba.local"
MAIL_FROM_NAME="${APP_NAME}"

# AI / LLM (Ollama)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_MODEL_FALLBACK_1=qwen2.5:1.5b
OLLAMA_MODEL_FALLBACK_2=simba-tutor-slim
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=16384
OLLAMA_NUM_PREDICT=2048
OLLAMA_TEMPERATURE=0.2

# Gemini API (optional - for fallback)
GEMINI_API_KEY=
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.8-flash:generateContent
GEMINI_SHORT_TIMEOUT=8
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Python / PDF Extraction
PYTHON_PATH=python3.14
PDF_EXTRACT_TIMEOUT=600

# Symbols / RAG
SYMBOLS_ENABLED=true
SYMBOLS_TOP_K=6
SYMBOLS_MIN_SCORE=1.0
SYMBOLS_MAX_CHARS=2400
SYMBOLS_FORMULA_MIN_CHARS=6
SYMBOLS_FORMULA_MATCH_THRESHOLD=0.9

RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=3
RAG_MIN_SCORE=0.4

# Kuis RAG
KUIS_RAG_ENABLED=true
KUIS_RAG_TOP_K=6
KUIS_RAG_MIN_SCORE=0.35
KUIS_RAG_MAX_CHARS=8000

# Bloom Taxonomy
BLOOM_ENABLED=true
BLOOM_MIN_CONFIDENCE=0.34

# Remedial
REMEDIAL_COOLDOWN_HARI=7
REMEDIAL_AMBANG_PERTEMUAN=75
REMEDIAL_BOBOT_TUGAS=0.8
REMEDIAL_BOBOT_KUIS=0.2

# Prediksi Risiko
PREDIKSI_AMBANG_AMAN=20
PREDIKSI_AMBANG_PANTAU=40

# Web Search (disabled by default)
WEB_SEARCH_ENABLED=false
WEB_SEARCH_TIMEOUT=5
WEB_SEARCH_MAX_RESULTS=3

# Filesystem
FILESYSTEM_DISK=public

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost:8000,127.0.0.1:8000
SESSION_DOMAIN=localhost