APP_NAME=SIMBA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Required for `php artisan db:seed`; set a strong local password first.
SEED_OPERATOR_PASSWORD=

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=simba
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=array
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@simba.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Ollama (lokal). fallback_1 dicoba sendLocalPreferred() setelah model utama;
# fallback_2 hanya dipakai jalur streaming. Keduanya default ke OLLAMA_MODEL,
# jadi isi hanya kalau memang mau model yang berbeda.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_MODEL_FALLBACK_1=qwen2.5:7b
# OLLAMA_MODEL_FALLBACK_2=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=16384
OLLAMA_NUM_PREDICT=2048
OLLAMA_TEMPERATURE=0.2

# Gemini (cloud). Model masuk ke URL endpoint default; isi GEMINI_ENDPOINT
# hanya kalau mau menimpa URL-nya sepenuhnya.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_ENDPOINT=
GEMINI_SHORT_TIMEOUT=30
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Provider embedding: ollama | gemini
EMBEDDING_PROVIDER=ollama

# RAG (AI tutor siswa)
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=3
RAG_MIN_SCORE=0.4

# Konteks generate soal: seluruh chunk materi pada pertemuan terpilih dikutip
# otomatis (urut document_id + chunk_index), anggaran dibagi proporsional.
SOAL_KONTEKS_ENABLED=true
SOAL_KONTEKS_MAX_CHARS=24000

# Ekstraksi PDF. PDF_FORMULA_OCR_MODEL wajib model vision — qwen2.5:7b dan
# qwen2.5-coder:1.5b-base text-only, jadi tidak bisa dipakai di sini.
PYTHON_PATH=py -X utf8
PDF_EXTRACT_TIMEOUT=600
PDF_FORMULA_OCR_ENABLED=true
PDF_FORMULA_OCR_MODEL=qwen3.5:4b
PDF_FORMULA_OCR_BUDGET=180

# Simbol + Bloom untuk generate soal
SYMBOLS_ENABLED=true
SYMBOLS_TOP_K=6
SYMBOLS_MIN_SCORE=1.0
SYMBOLS_MAX_CHARS=2400
SYMBOLS_FORMULA_MIN_CHARS=6
SYMBOLS_FORMULA_MATCH_THRESHOLD=0.9
BLOOM_ENABLED=true
BLOOM_MIN_CONFIDENCE=0.34

# Remedial + prediksi risiko
REMEDIAL_COOLDOWN_HARI=7
REMEDIAL_AMBANG_PERTEMUAN=75
REMEDIAL_BOBOT_TUGAS=0.8
REMEDIAL_BOBOT_KUIS=0.2
PREDIKSI_AMBANG_AMAN=20
PREDIKSI_AMBANG_PANTAU=40

# Layanan ML eksternal (opsional; default-nya ml:train lokal)
ML_SERVICE_ENDPOINT=http://localhost:5000
ML_SERVICE_API_KEY=

# Web search Google CSE (opsional)
WEB_SEARCH_ENABLED=false
WEB_SEARCH_TIMEOUT=5
WEB_SEARCH_MAX_RESULTS=3
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
